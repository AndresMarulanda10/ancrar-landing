---
import Footer from '../components/layout/Footer';
import Header from '../components/layout/Header';
import { appDescription, keywords as defaultKeywords } from '../content/home';
import '../styles/fonts.css';

interface Props {
    title: string;
    description?: string;
    keywords?: string[];
    noindex?: boolean;
}

const {
    title,
    description = appDescription,
    keywords = defaultKeywords,
    noindex = false,
} = Astro.props;
const defaultSiteUrl = 'https://ancrar-landing.vercel.app';
const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL?.trim() || defaultSiteUrl;
let publicSiteUrl = defaultSiteUrl;

try {
    publicSiteUrl = new URL(configuredSiteUrl).toString();
} catch {
    publicSiteUrl = defaultSiteUrl;
}

const canonicalUrl = new URL(Astro.url.pathname, publicSiteUrl).toString();
const ogImageUrl = new URL('/og-image.png', publicSiteUrl).toString();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content={description}
        />
        {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/ancrar-icon.svg" />
        <link rel="apple-touch-icon" href="/ancrar-icon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#54BCAC" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="ANCRAR" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="ANCRAR Spanish verb conjugation practice" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content="ANCRAR Spanish verb conjugation practice" />
        <link rel="canonical" href={canonicalUrl} />
        <title>{title}</title>
    </head>
    <body class="font-Helvetica overflow-x-hidden bg-appBody text-appText">
        <div class="overflow-hidden flex flex-col min-h-screen">
            <Header />
            <main class="flex flex-col flex-1"><slot /></main>
            <Footer />
        </div>
    </body>
</html>

<style is:global>
@import "tailwindcss";
@config "../../tailwind.config.mjs";
</style>
