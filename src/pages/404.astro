---
import Btn from '../components/Btn';
import Layout from '../layouts/Layout.astro';
---

<Layout title={'Page Not Found'} noindex>
    <div class="flex min-h-[400px] flex-col items-center justify-center gap-6 bg-[#F4F4F4] lg:gap-10">
        <h1 class="text-center text-3xl font-semibold text-[#142C3C] md:text-4xl lg:text-5xl">
            Page Not Found
        </h1>
        <Btn
            theme="accent"
            size="sm"
            to="/"
            className="px-4 py-[13px] md:px-6 md:py-4"
        >
            Go back home
        </Btn>
    </div>
</Layout>
