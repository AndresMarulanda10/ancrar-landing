---
import HomeHero from "../components/home-page/Hero";
import Features from "../components/home-page/Features";
import Quotes from "../components/home-page/Quotes";
import DigitalNomad from "../components/home-page/DigitalNomad";
import Brands from "../components/home-page/Brands";
import QA from "../components/home-page/QA";
import Layout from "../layouts/Layout.astro";
import { appDescription, keywords, titleOptions } from '../content/home';
---

	<Layout
	    title={titleOptions[0]}
	    description={appDescription}
	    keywords={keywords}
>
    <div>
        <HomeHero />
        <Features />
        <Quotes />
        <DigitalNomad />
        <Brands />
        <QA client:load />
    </div>
</Layout>
